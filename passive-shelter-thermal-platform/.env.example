# ============================================================
# Passive Thermal Shelter Platform - Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ANSYS Configuration
ANSYS_INSTALL_PATH=D:\ANSYS\ANSYS Inc\ANSYS Student\v261
ANSYS_VERSION=261
ANSYS_MAPDL_EXE=D:\ANSYS\ANSYS Inc\ANSYS Student\v261\ansys\bin\winx64\ansys261.exe
MAPDL_PORT=50052
MAPDL_START_TIMEOUT=120

# Database
DATABASE_URL=sqlite:///./data/shelter_thermal.db

# Data Directories
DATA_DIR=./data
SIMULATIONS_DIR=./data/simulations
REPORTS_DIR=./data/reports
DESIGNS_DIR=./data/designs

# Weather API (Open-Meteo - no API key required for basic usage)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Simulation Defaults
MAX_CONCURRENT_SIMULATIONS=1
DEFAULT_TIME_STEP_SECONDS=3600
DEFAULT_SIMULATION_HOURS=24
DEFAULT_MESH_SIZE=0.1

# Comfort Range Defaults (Celsius)
DEFAULT_COMFORT_MIN=18.0
DEFAULT_COMFORT_MAX=27.0

# Development Mode
DEV_MODE=false
